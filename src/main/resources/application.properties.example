# ========================================================
# BloodConnect Application Configuration
# ========================================================

# Application Information
app.name=BloodConnect
app.version=1.0.0
app.context=/BloodConnect
app.port=8080

# Database Configuration (MySQL / MariaDB)
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/bloodconnect_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.user=root
db.password=root

# Connection Pool Settings
db.pool.initialSize=5
db.pool.maxTotal=20
db.pool.maxIdle=10
db.pool.minIdle=2
db.pool.maxWaitMillis=10000

# Zero-Config Fallback (Set to true if MySQL is not available during local student demo)
db.fallback.h2=true
